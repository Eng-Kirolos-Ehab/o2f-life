  {id:'done', stage:'files', type:'done'},
];

const stagesEl = document.getElementById('stages');
STAGES.forEach(()=>{const s=document.createElement('span');s.appendChild(document.createElement('i'));stagesEl.appendChild(s)});

function visible(){ return STEPS.filter(s=>!s.show || s.show()); }
function award(n,msg){ points+=n; document.getElementById('pts').textContent=`⭐ ${points} نقطة`; if(msg){const p=document.createElement('div');p.className='pop';p.textContent=msg;document.body.appendChild(p);setTimeout(()=>p.remove(),1700);} }
function esc(s){return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}
const fmtH = h => { h=((h%24)+24)%24; const hh=Math.floor(h), mm=h%1?'30':'00'; const p=hh<12?'ص':'م'; const d=hh%12===0?12:hh%12; return `${d}:${mm} ${p}`; };
const span = (a,b) => ((b-a)%24+24)%24;

function render(){
  const steps=visible(); if(idx>=steps.length) idx=steps.length-1;
  const s=steps[idx]; const app=document.getElementById('app');
  const si=STAGES.findIndex(x=>x.id===s.stage);
  [...stagesEl.children].forEach((el,i)=>{
    const inStage=steps.filter(x=>x.stage===STAGES[i].id); const done=inStage.filter(x=>steps.indexOf(x)<idx).length;
    el.firstChild.style.transform=`scaleX(${i<si?1:i>si?0:done/inStage.length})`;
  });
  document.getElementById('stageLabel').textContent=`${val(STAGES[si].ic)} ${val(STAGES[si].name)}`;
  document.getElementById('stageCount').textContent=`المرحلة ${si+1} من ${STAGES.length}`;

  const c=document.createElement('section'); c.className='card';
  const q=s.q?`<h2>${s.q()}</h2>`:''; const hint=s.hint?`<p class="hint">${val(s.hint)}</p>`:'';
  let body='', canNext=true;

  if(s.type==='welcome'){
    c.classList.add('stage-intro');
    c.innerHTML=`<div class="ic">🌱</div><h1>Welcome to Osama's World</h1><p class="hint" style="margin:0">أنا الكوتش أسامة، وهذي مو استمارة مملة. هذي أول خطوة في رحلتك معاي: 8 مراحل صغيرة، تقريباً 6 دقايق، وكل إجابة ${t('تكسبك','تكسبك')} نقاط ⭐ وفي الآخر ${t('تاخذ','تاخذي')} بطاقة رحلتك.</p><button class="btn" id="go" style="width:100%">يلا نبدأ</button>`;
    app.replaceChildren(c); c.querySelector('#go').onclick=()=>next(); return;
  }
  if(s.type==='intro'){
    c.classList.add('stage-intro');
    c.innerHTML=`<span class="badge">مرحلة جديدة</span><div class="ic">${val(STAGES[si].ic)}</div><h2>${s.q()}</h2>${hint}<div class="nav" style="width:100%"><button class="back" id="bk">رجوع</button><button class="btn" id="nx">كمّل</button></div>`;
    app.replaceChildren(c); c.querySelector('#nx').onclick=()=>next(); c.querySelector('#bk').onclick=back; return;
  }
  if(s.type==='done') return renderDone(app,c);
  if(s.type==='consent'){
    c.innerHTML=`<h2>خلاص قرّبنا! 🎉</h2><p class="hint">${t('لما تضغط الزر ينفتح لك الواتساب ورسالة فيها كل إجاباتك، اضغط إرسال بس.','لما تضغطي الزر ينفتح لك الواتساب ورسالة فيها كل إجاباتك، اضغطي إرسال بس.')}</p><label class="consent"><input type="checkbox" id="f_consent" ${A.consent?'checked':''}><span>أوافق إن الكوتش أسامة يطّلع على بياناتي وصوري وتحاليلي عشان يسوي برنامجي، وأعرف إن البرنامج توجيهات تدريب وتغذية ومو بديل عن الطبيب.</span></label><div class="nav"><button class="back" id="bk">رجوع</button><button class="btn" id="nx" ${A.consent?'':'disabled'}>${t('أرسل للكوتش على واتساب 🚀','أرسلي للكوتش على واتساب 🚀')}</button></div>`;
    app.replaceChildren(c);
    const cb=c.querySelector('#f_consent'), nx=c.querySelector('#nx');
    cb.onchange=()=>{A.consent=cb.checked;nx.disabled=!cb.checked;save()};
    nx.onclick=()=>{
      // Opened synchronously inside the click so phones don't block it as a pop-up.
      A.wa_link=waLink(); save();
      award(50,t('+50 خلّصت الرحلة!','+50 خلّصتي الرحلة!')); next();
      window.location.href=A.wa_link;
    };
    c.querySelector('#bk').onclick=back; return;
  }

  if(s.type==='choice'){
    body=`<div class="opts ${s.big?'big':''}">${val(s.opts).map(o=>`<button class="opt" data-v="${o.v}" aria-pressed="${A[s.id]===o.v}"><span class="ic">${o.ic}</span>${g==='f'&&o.lf?o.lf:o.l}</button>`).join('')}</div>`;
    canNext=A[s.id]!=null;
  } else if(s.type==='multi'){
    const cur=A[s.id]||[]; const all=[...s.opts,...(s.none?[s.none]:[])];
    body=`<div class="chips">${all.map(o=>`<button class="chip" data-v="${esc(o)}" aria-pressed="${cur.includes(o)}">${o}</button>`).join('')}</div>`;
    canNext=cur.length>0;
  } else if(s.type==='text'){
    body=`<input id="f_${s.id}" type="${s.inputType||'text'}" placeholder="${s.ph||''}" value="${esc(A[s.id]||'')}" autocomplete="off">`;
    canNext=s.optional||!!(A[s.id]||'').trim();
  } else if(s.type==='textarea'){
    body=`<textarea id="f_${s.id}" placeholder="${s.ph||''}">${esc(A[s.id]||'')}</textarea>`;
    canNext=s.optional||!!(A[s.id]||'').trim();
  } else if(s.type==='date'){
    body=`<input id="f_${s.id}" type="date" value="${A[s.id]||''}">`;
  } else if(s.type==='slider'){
    if(A[s.id]==null) A[s.id]=val(s.def);
    body=`<div class="slider"><output id="o">${A[s.id]}<small>${s.unit}</small></output><input id="f_${s.id}" type="range" min="${s.min}" max="${s.max}" value="${A[s.id]}"></div>`;
  } else if(s.type==='stepper'){
    if(A[s.id]==null) A[s.id]=s.def;
    body=`<div class="stepper"><button id="plus" aria-label="زيادة">+</button><output id="o">${A[s.id]}</output><button id="minus" aria-label="نقص">−</button></div>${s.water?'<div class="glasses" id="gl"></div>':''}`;
  } else if(s.type==='scale'){
    const emo=s.emo||['😩','😕','😐','🙂','⚡'];
    body=`<div class="scale">${emo.map((e,i)=>`<button data-v="${i+1}" aria-pressed="${A[s.id]===i+1}" aria-label="${i+1}">${e}</button>`).join('')}</div><div class="scale-lbl"><span>${s.lo}</span><span>${s.hi}</span></div>`;
    canNext=A[s.id]!=null;
  } else if(s.type==='upload'){
    body=`<label class="drop" id="drop"><span class="ic">📄</span><strong>اضغط هنا أو اسحب الملفات</strong><span class="muted">PDF أو صور، أكثر من ملف عادي</span><input id="f_${s.id}" type="file" multiple accept="image/*,application/pdf" hidden></label><div class="files" id="fl"></div>`;
  } else if(s.type==='day'){
    if(!A.dayclock) A.dayclock={wake:6,sleep:23,works:true,ws:8,we:16};
    const d=A.dayclock;
    body=`<div class="day"><svg viewBox="0 0 200 200" id="ring" role="img" aria-label="رسم اليوم"></svg>
      <div class="legend"><span><i style="background:var(--sleep)"></i>نوم</span><span><i style="background:var(--work)"></i>دوام / دراسة</span><span><i style="background:var(--free)"></i>وقت متاح</span></div>
      <div class="rows">
        <label>🌅 أصحى <input type="range" id="d_wake" min="3" max="13" step="0.5" value="${d.wake}"><output id="o_wake"></output></label>
        <label>🌙 أنام <input type="range" id="d_sleep" min="19" max="28" step="0.5" value="${d.sleep}"><output id="o_sleep"></output></label>
        <span class="toggle"><input type="checkbox" id="d_works" ${d.works?'checked':''}><label for="d_works" style="display:inline">أشتغل أو أدرس</label></span>
        <label id="r_ws">💼 من <input type="range" id="d_ws" min="0" max="23.5" step="0.5" value="${d.ws}"><output id="o_ws"></output></label>
        <label id="r_we">🏁 إلى <input type="range" id="d_we" min="0" max="23.5" step="0.5" value="${d.we}"><output id="o_we"></output></label>
      </div></div>`;
  } else if(s.type==='swipe'){
    if(!A.foods) A.foods={};
    body=`<div class="deck" id="deck"></div><div class="deck-count" id="dc"></div><div class="votes"><button id="v_no" aria-label="ما أحبه">👎</button><button id="v_meh" aria-label="عادي">🤷</button><button id="v_yes" aria-label="أحبه">❤️</button></div>`;
  } else if(s.type==='photos'){
    if(!A.photos) A.photos={};
    const slots=[['front','من قدّام','🧍'],['side','من الجنب','🚶'],['back','من ورا','🧍']];
    body=`<p class="hint">${t('صوّرها وأنت لابس شورت، وتقدر تقصّ وجهك منها','صوّريها وأنتي لابسة لبس رياضي، وتقدري تقصّي وجهك منها')}</p>
      <div class="shots">${slots.map(([k,l,e])=>`<label class="shot ${A.photos[k]?'ok':''}" id="s_${k}"><input type="file" accept="image/*" hidden data-k="${k}">${previews[k]?`<img src="${previews[k]}" alt="">`:`<span class="sil">${e}</span>`}${A.photos[k]?'<b>✓ '+l+'</b>':`<span>${l}</span>`}</label>`).join('')}</div>
      <ul class="tips"><li>📐 الموبايل على مستوى الصدر</li><li>⬜ خلفية فاتحة لو ينفع</li><li>💡 إضاءة كويسة</li><li>🔒 ما يشوفها أحد غيري</li></ul>`;
  } else if(s.type==='measure'){
    if(!A.measures) A.measures={};
    body=`<p class="hint">${t('قيس','قيسي')} الصبح بشريط القياس، والشريط على الجلد بدون ضغط</p><div class="meas">${MEAS.map(([k,l])=>`<label>${l}<span class="in"><input type="number" inputmode="decimal" id="m_${k}" min="10" max="250" value="${A.measures[k]||''}"><span>سم</span></span></label>`).join('')}</div>`;
  }

  c.innerHTML=`${q}${hint}${body}<div id="fb"></div><div class="nav"><button class="back" id="bk" ${idx<=1?'hidden':''}>رجوع</button><button class="btn" id="nx" ${canNext?'':'disabled'}>التالي</button></div>${s.optional?'<button class="skip" id="sk">تخطّي</button>':''}`;
  app.replaceChildren(c);
  const nx=c.querySelector('#nx'), fbEl=c.querySelector('#fb');
  const showFb=()=>{const f=s.fb&&A[s.id]!=null?s.fb(A[s.id]):null; fbEl.innerHTML=f?`<div class="feedback ${f.warn?'warn':''}"><span>${f.warn?'⚠️':'💡'}</span><span>${f.m}</span></div>`:''};
  const say=(m,warn)=>{fbEl.innerHTML=m?`<div class="feedback ${warn?'warn':''}"><span>${warn?'⚠️':'💡'}</span><span>${m}</span></div>`:''};
  showFb();
  c.querySelector('#bk').onclick=back; nx.onclick=()=>next();
  const sk=c.querySelector('#sk'); if(sk) sk.onclick=()=>next(true);

  if(s.type==='choice'){
    c.querySelectorAll('.opt').forEach(b=>b.onclick=()=>{
      A[s.id]=b.dataset.v;
      if(s.id==='gender'){ g=A.gender; document.body.classList.toggle('f',g==='f'); }
      c.querySelectorAll('.opt').forEach(x=>x.setAttribute('aria-pressed',x===b)); nx.disabled=false; showFb(); save();
      if(!(s.fb&&s.fb(A[s.id])?.warn)) setTimeout(()=>next(),260);
    });
  }
  if(s.type==='multi'){
    c.querySelectorAll('.chip').forEach(b=>b.onclick=()=>{
      let cur=A[s.id]||[]; const v=b.dataset.v;
      if(v===s.none) cur=cur.includes(v)?[]:[v];
      else { cur=cur.filter(x=>x!==s.none); cur=cur.includes(v)?cur.filter(x=>x!==v):[...cur,v]; }
      A[s.id]=cur; c.querySelectorAll('.chip').forEach(x=>x.setAttribute('aria-pressed',cur.includes(x.dataset.v))); nx.disabled=!cur.length; save();
    });
  }
  const inp=c.querySelector(`#f_${s.id}`);
  if(['text','textarea','date'].includes(s.type)){
    inp.oninput=()=>{A[s.id]=inp.value; if(!s.optional&&s.type!=='date') nx.disabled=!inp.value.trim(); save()};
    if(s.type==='text'){ inp.onkeydown=e=>{if(e.key==='Enter'&&!nx.disabled)next()}; setTimeout(()=>inp.focus({preventScroll:true}),350); }
  }
  if(s.type==='slider'){
    const o=c.querySelector('#o'); inp.oninput=()=>{A[s.id]=+inp.value;o.innerHTML=`${inp.value}<small>${s.unit}</small>`;showFb();save()};
  }
  if(s.type==='stepper'){
    const o=c.querySelector('#o'), gl=c.querySelector('#gl');
    const upd=()=>{o.textContent=A[s.id]; if(gl) gl.textContent='💧'.repeat(A[s.id]); showFb(); save()};
    c.querySelector('#plus').onclick=()=>{A[s.id]=Math.min(s.max,A[s.id]+1);upd()};
    c.querySelector('#minus').onclick=()=>{A[s.id]=Math.max(s.min,A[s.id]-1);upd()}; upd();
  }
  if(s.type==='scale'){
    c.querySelectorAll('.scale button').forEach(b=>b.onclick=()=>{A[s.id]=+b.dataset.v;c.querySelectorAll('.scale button').forEach(x=>x.setAttribute('aria-pressed',x===b));nx.disabled=false;save();setTimeout(()=>next(),260)});
  }
  if(s.type==='upload'){
    const drop=c.querySelector('#drop'), fl=c.querySelector('#fl');
    const list=()=>{fl.innerHTML=(A[s.id]||[]).map(f=>`<div><span>📎 ${esc(f.name)}</span><span class="muted">${(f.size/1024/1024).toFixed(1)} MB</span></div>`).join('')};
    const add=files=>{const ok=[...files].filter(f=>f.size<=15e6&&(/^image\//.test(f.type)||f.type==='application/pdf'));
      if(ok.length<files.length) say('بعض الملفات ما انضافت: لازم تكون صور أو PDF وحجمها أقل من 15 ميجا',1); else say('');
      fileStore.labs.push(...ok); A[s.id]=[...(A[s.id]||[]),...ok.map(f=>({name:f.name,size:f.size}))];list();save()};
    inp.onchange=()=>add(inp.files);
    drop.ondragover=e=>{e.preventDefault();drop.classList.add('over')}; drop.ondragleave=()=>drop.classList.remove('over');
    drop.ondrop=e=>{e.preventDefault();drop.classList.remove('over');add(e.dataTransfer.files)}; list();
  }
  if(s.type==='day') wireDay(c,say);
  if(s.type==='swipe') wireSwipe(c,say);
  if(s.type==='photos'){
    c.querySelectorAll('.shot input').forEach(i=>i.onchange=()=>{
      const f=i.files[0]; if(!f) return; const k=i.dataset.k;
      try{ if(previews[k]) URL.revokeObjectURL(previews[k]); previews[k]=URL.createObjectURL(f);}catch(e){}
      fileStore.photos[k]=f; A.photos[k]=f.name; save(); award(5); render();
    });
  }
  if(s.type==='measure'){
    MEAS.forEach(([k])=>{const m=c.querySelector('#m_'+k); m.oninput=()=>{A.measures[k]=m.value;save();
      const w=+A.measures.waist, h=A.height; say(w&&h?`نسبة الخصر للطول <b>${(w/h).toFixed(2)}</b> ${w/h<0.5?'(ممتازة، أقل من 0.5)':'(هدفنا ننزّلها تحت 0.5)'}`:'');}});
  }
}

function wireDay(c,say){
  const d=A.dayclock, svg=c.querySelector('#ring');
  const R=78, C=2*Math.PI*R;
  const seg=(a,b,color)=>{const len=span(a,b)/24*C; return `<circle cx="100" cy="100" r="${R}" fill="none" stroke="${color}" stroke-width="22" stroke-dasharray="${len} ${C}" transform="rotate(${(a/24)*360-90} 100 100)"/>`};
  const ticks=[0,6,12,18].map(h=>{const an=(h/24)*2*Math.PI-Math.PI/2;return `<text x="${100+Math.cos(an)*104*0.93}" y="${100+Math.sin(an)*104*0.93+4}" font-size="10" fill="var(--muted)" text-anchor="middle">${h===0?'12ص':h===12?'12م':h===6?'6ص':'6م'}</text>`}).join('');
  const draw=()=>{
    const sleepH=span(d.sleep,d.wake), workH=d.works?span(d.ws,d.we):0, free=Math.max(0,24-sleepH-workH);
    svg.innerHTML=`<circle cx="100" cy="100" r="${R}" fill="none" stroke="var(--free)" stroke-width="22"/>${seg(d.sleep%24,d.wake,'var(--sleep)')}${d.works?seg(d.ws,d.we,'var(--work)'):''}${ticks}
      <text x="100" y="92" text-anchor="middle" font-size="12" fill="var(--muted)">وقت متاح</text>
      <text x="100" y="118" text-anchor="middle" font-size="28" font-weight="900" fill="var(--accent)">${free} س</text>`;
    ['wake','sleep','ws','we'].forEach(k=>c.querySelector('#o_'+k).textContent=fmtH(d[k]));
    c.querySelector('#r_ws').hidden=c.querySelector('#r_we').hidden=!d.works;
    A.sleep_hours=sleepH;
    say(sleepH<6?`نومك تقريباً <b>${sleepH} ساعات</b> بس. النوم من أول الأشياء اللي بنظبطها سوا 😴`:sleepH<=9?`نومك تقريباً <b>${sleepH} ساعات</b>، حلو 👌`:`نومك <b>${sleepH} ساعات</b>، هذا كثير شوي، بنشوف السبب سوا.`, sleepH<6);
    save();
  };
  ['wake','sleep','ws','we'].forEach(k=>c.querySelector('#d_'+k).oninput=e=>{d[k]=+e.target.value;draw()});
  c.querySelector('#d_works').onchange=e=>{d.works=e.target.checked;draw()};
  draw();
}

function wireSwipe(c,say){
  const deck=c.querySelector('#deck'), dc=c.querySelector('#dc');
  const pending=()=>FOODS.filter(([,n])=>!(n in A.foods));
  const draw=()=>{
    const p=pending(); deck.innerHTML='';
    dc.textContent=`${FOODS.length-p.length} / ${FOODS.length}`;
    if(!p.length){
      const likes=FOODS.filter(([,n])=>A.foods[n]==='yes').map(x=>x[0]).join(' ');
      const nos=FOODS.filter(([,n])=>A.foods[n]==='no').map(x=>x[0]).join(' ');
      deck.innerHTML=`<div style="text-align:center;display:flex;flex-direction:column;gap:8px"><div style="font-size:15px;color:var(--muted)">${t('تحبه','تحبيه')}</div><div style="font-size:30px">${likes||'—'}</div><div style="font-size:15px;color:var(--muted)">${t('ما تحبه','ما تحبيه')}</div><div style="font-size:30px">${nos||'—'}</div></div>`;
      c.querySelector('.votes').hidden=true; say(t('تمام! بسوي برنامجك على الأكل اللي تحبه ❤️','تمام! بسوي برنامجك على الأكل اللي تحبيه ❤️')); return;
    }
    p.slice(0,2).reverse().forEach(([e,n],i,arr)=>{
      const el=document.createElement('div'); el.className='food'+(i===0&&arr.length>1?' under':'');
      el.innerHTML=`<span class="tag yes">أحبه</span><span class="tag no">لا</span><span class="em">${e}</span>${n}`;
      deck.appendChild(el);
    });
    const top=deck.lastElementChild; let x0=null, dx=0;
    top.onpointerdown=e=>{x0=e.clientX;top.setPointerCapture(e.pointerId);top.style.transition='none'};
    top.onpointermove=e=>{if(x0==null)return;dx=e.clientX-x0;top.style.transform=`translateX(${dx}px) rotate(${dx/14}deg)`;
      top.querySelector('.yes').style.opacity=dx>30?1:0; top.querySelector('.no').style.opacity=dx<-30?1:0;};
    top.onpointerup=()=>{top.style.transition='';if(dx>80)vote('yes');else if(dx<-80)vote('no');else top.style.transform='';x0=null;dx=0};
  };
  const vote=v=>{
    const p=pending(); if(!p.length) return; const top=deck.lastElementChild;
    A.foods[p[0][1]]=v; save(); award(2);
    top.style.transform=v==='yes'?'translateX(140%) rotate(20deg)':v==='no'?'translateX(-140%) rotate(-20deg)':'translateY(-40px) scale(.8)'; top.style.opacity=0;
    setTimeout(draw,260);
  };
  c.querySelector('#v_yes').onclick=()=>vote('yes'); c.querySelector('#v_no').onclick=()=>vote('no'); c.querySelector('#v_meh').onclick=()=>vote('meh');
  draw();
}

function next(skipped){
  const steps=visible(); const s=steps[idx];
  if(!skipped && !['intro','welcome','consent'].includes(s.type)) award(10);
  const steps2=visible(); const nextS=steps2[steps2.indexOf(s)+1];
  if(nextS && nextS.stage!==s.stage && s.type!=='welcome') award(20,`+20 ${t('خلّصت','خلّصتي')} مرحلة ${val(STAGES.find(x=>x.id===s.stage).name)} 👏`);
  idx=Math.min(steps2.indexOf(s)+1,steps2.length-1); save(); render(); window.scrollTo({top:0,behavior:'smooth'});
}
function back(){ idx=Math.max(0,idx-1); save(); render(); }

function renderDone(app,c){
  const water=A.weight?(A.weight*0.035).toFixed(1):'—';
  const bmi=A.weight&&A.height?(A.weight/((A.height/100)**2)).toFixed(1):'—';
  const d=A.dayclock; const free=d?Math.max(0,24-span(d.sleep,d.wake)-(d.works?span(d.ws,d.we):0)):'—';
  c.classList.add('stage-intro');
  c.innerHTML=`<div class="ic">🏆</div><h1>برافو يا ${esc(A.name||t('بطل','بطلة'))}!</h1>
    <p class="hint" style="margin:0">${t('جمعت','جمعتي')} <b style="color:var(--gold)">${points} نقطة</b>، وهذي بطاقة رحلتك.</p>
    <div class="feedback warn" style="text-align:right"><span>📸</span><span>${t('بعد ما ترسل الرسالة، أرسل لي في نفس المحادثة','بعد ما ترسلي الرسالة، أرسلي لي في نفس المحادثة')}: <b>3 صور للجسم</b> (قدّام، جنب، ورا)${A.has_labs==='no'?'':' و<b>التحاليل</b>'}.</span></div>
    <a class="btn" href="${A.wa_link||waLink()}" style="text-decoration:none;width:100%;text-align:center">${t('ما انفتح الواتساب؟ اضغط هنا','ما انفتح الواتساب؟ اضغطي هنا')}</a>
    <div class="reward"><div><b>${water}</b><span>لتر ماء هدفك اليومي</span></div><div><b>${bmi}</b><span>مؤشر كتلة الجسم</span></div><div><b>${free}</b><span>ساعات متاحة في يومك</span></div></div>
    <p class="muted">${t('ابدأ من اليوم بهدف الماء، وخلّينا نمشي سوا خطوة خطوة 💪','ابدئي من اليوم بهدف الماء، وخلّينا نمشي سوا خطوة خطوة 💪')}</p>
    <a class="back" href="/" style="text-decoration:none">الرجوع للموقع</a>`;
  app.replaceChildren(c);
  try{ localStorage.removeItem('o2f-intake2') }catch(e){}
}

function save(){ try{ localStorage.setItem('o2f-intake2',JSON.stringify({A,g,idx,points})) }catch(e){} }
function start(){
  try{ const d=JSON.parse(localStorage.getItem('o2f-intake2')||'null'); if(d){Object.assign(A,d.A);g=d.g;idx=d.idx;points=d.points;} }catch(e){}
  if(g==='f') document.body.classList.add('f');
  award(0); render();
}

/* ---------- send to Osama on WhatsApp ---------- */
// No database: the answers go straight to Osama's WhatsApp as one ready-to-send message.
const WHATSAPP='201279777609';

function optLabel(id,v){
  const s=STEPS.find(x=>x.id===id); if(!s||v==null) return v;
  const o=(val(s.opts)||[]).find(x=>x.v===v); return o?((g==='f'&&o.lf)||o.l):v;
}
function computeFlags(){
  const f=[];
  if(A.age<16) f.push('قاصر: يحتاج موافقة ولي الأمر');
  if(A.cycle==='preg') f.push('حامل');
  if(A.cycle==='bf') f.push('مرضعة');
  if((A.conditions||[]).includes('نقص G6PD')) f.push('G6PD: ممنوع المؤكسدات والميثيلين بلو وجرعات فيتامين C العالية');
  if(A.peptides==='yes') f.push('يستخدم ببتيدات حالياً');
  if(A.sleep_hours<6) f.push(`نوم قليل: ${A.sleep_hours} ساعات`);
  return f;
}
function buildMessage(){
  const L=[], add=(k,v)=>{ if(v!=null && v!=='' && !(Array.isArray(v)&&!v.length)) L.push(`${k}: ${Array.isArray(v)?v.join('، '):v}`); };
  const head=h=>L.push('', h);
  L.push(`السلام عليكم كوتش أسامة 👋 هذي بياناتي من استمارة O2F`);
  const flags=computeFlags(); if(flags.length){ head('⚠️ تنبيهات'); flags.forEach(x=>L.push('• '+x)); }
  head('👋 تعارف');
  add('الاسم',A.name); add('النوع',g==='f'?'امرأة':'رجل'); add('العمر',A.age&&A.age+' سنة');
  add('البلد',optLabel('country',A.country)); add('المدينة',A.city); add('واتساب',A.whatsapp); add('مدة الاشتراك',optLabel('plan',A.plan));
  head('📏 الجسم');
  add('الطول',A.height&&A.height+' سم'); add('الوزن',A.weight&&A.weight+' كجم');
  if(A.weight&&A.height) add('مؤشر كتلة الجسم',(A.weight/((A.height/100)**2)).toFixed(1));
  add('أدوات في البيت',A.tools);
  const m=A.measures||{}; const ms=MEAS.filter(([k])=>m[k]).map(([k,l])=>`${l} ${m[k]}`); add('المقاسات (سم)',ms);
  head('🩺 الصحة');
  add('أمراض',A.conditions); add('أدوية',A.meds); add('عمليات / إصابات',A.surgery);
  add('الطاقة',A.energy&&A.energy+'/5'); add('التوتر',A.stress&&A.stress+'/5'); add('جودة النوم',A.sleepq&&A.sleepq+'/5'); add('الهضم',A.digestion);
  if(g==='f'){ add('الدورة',optLabel('cycle',A.cycle)); add('آخر دورة',A.last_period); add('مشاكل نسائية',A.women_issues); add('علاج هرموني',optLabel('hormones',A.hormones)); }
  else add('صحة الرجل',A.men_issues);
  head('🕐 اليوم');
  const d=A.dayclock; if(d){ add('الصحيان',fmtH(d.wake)); add('النوم',fmtH(d.sleep)); add('ساعات النوم',A.sleep_hours); if(d.works) add('الدوام',`${fmtH(d.ws)} إلى ${fmtH(d.we)}`); }
  add('التنقل',optLabel('commute',A.commute)); add('ملاحظة عن اليوم',A.daynote);
  head('🥗 الأكل');
  const fo=A.foods||{}; add('يحب',Object.keys(fo).filter(k=>fo[k]==='yes')); add('ما يحب',Object.keys(fo).filter(k=>fo[k]==='no'));
  add('النظام',optLabel('diet',A.diet)); add('عدد الوجبات',A.meals); add('أكواب الماء',A.water);
  add('حساسية',A.allergy); add('الميزانية',optLabel('budget',A.budget)); add('مكمّلات',A.supps);
  add('ببتيدات / حقن',A.peptides==='yes'?(A.peptides_detail||'نعم'):'لا');
  head('🎯 الهدف والتمرين');
  add('الأهداف',A.goals); add('مكان التمرين',optLabel('place',A.place)); add('أيام التمرين',A.days);
  add('وقت التمرين',optLabel('train_time',A.train_time)); add('مدة التمرين',optLabel('duration',A.duration));
  add('الجاهزية',A.commit&&A.commit+'/10'); add('ليش الحين',A.why);
  head('📩 آخر شي');
  add('التحاليل',optLabel('has_labs',A.has_labs)); add('طريقة الدفع',optLabel('pay',A.pay)); add('ملاحظات',A.extra);
  L.push('', '📸 بأرسل صوري وتحاليلي هنا بعد هذي الرسالة.');
  return L.join('\n').replace(/\n{3,}/g,'\n\n');
}
function waLink(){ return `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(buildMessage())}`; }

start();
</script>
{% endraw %}
</body>
</html>
