  {id:'duration', stage:'goal', type:'choice', q:()=>'كم وقت متاح عندك للتمرين في اليوم؟',
    opts:[{v:'30',ic:'⏱️',l:'نص ساعة'},{v:'45',ic:'⏱️',l:'45 دقيقة'},{v:'60',ic:'⏱️',l:'ساعة'},{v:'90',ic:'⏱️',l:'ساعة ونص'},{v:'120',ic:'⏱️',l:'ساعتين'}]},
  {id:'commit', stage:'goal', type:'slider', q:()=>t('من 1 إلى 10، كم أنت جاهز تبدأ؟','من 1 إلى 10، كم أنتي جاهزة تبدأي؟'), min:1,max:10,def:8,unit:'/10',
    fb:v=> v>=8 ? {m:'هذا الكلام! 🔥'} : {m:'ولا يهمك، نبدأ سوا بخطوات صغيرة تناسبك.'}},
