---
layout: false
permalink: /start/
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#0B1220">
<title>O2F رحلة البداية</title>
<link rel="icon" href="/assets/images/favicon.webp">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap">
<style>
:root{
  color-scheme: dark;
  --ink:#0B1220; --panel:#121B2E; --panel2:#18233A; --line:rgba(255,255,255,.09);
  --mint:#00D9A3; --mint-soft:rgba(0,217,163,.14); --gold:#C9A84A; --gold-soft:rgba(201,168,74,.16);
  --rose:#E58BAA; --rose-soft:rgba(229,139,170,.15);
  --sleep:#6C7BD9; --work:#C9A84A; --free:#2A3650;
  --text:#F2F5F8; --muted:#95A0B3; --warn:#F2B35B; --bad:#E5736B;
  --accent:var(--mint); --accent-soft:var(--mint-soft);
}
body.f{ --accent:var(--rose); --accent-soft:var(--rose-soft); }
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--ink);color:var(--text);font-family:Tajawal,"Segoe UI",Tahoma,system-ui,sans-serif;font-size:17px;line-height:1.6;
  background-image:radial-gradient(700px 400px at 85% -10%, var(--accent-soft), transparent 70%)}
.wrap{max-width:560px;margin:0 auto;padding-inline:16px;padding-block:18px 40px;min-height:100%;display:flex;flex-direction:column;gap:18px}
header{display:flex;align-items:center;justify-content:space-between;gap:12px}
.logo{font-weight:900;letter-spacing:.5px;font-size:20px}
.logo b{color:var(--accent)}
.pts{font-size:14px;color:var(--gold);background:var(--gold-soft);padding:4px 12px;border-radius:99px;font-variant-numeric:tabular-nums;white-space:nowrap}
.stages{display:flex;gap:5px}
.stages span{flex:1;height:6px;border-radius:99px;background:var(--line);position:relative;overflow:hidden}
.stages span i{position:absolute;inset:0;background:var(--accent);transform-origin:right;transform:scaleX(0);transition:transform .45s ease}
.stage-name{font-size:14px;color:var(--muted);display:flex;justify-content:space-between}
.stage-name strong{color:var(--accent);font-weight:700}
.card{background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:26px 20px;display:flex;flex-direction:column;gap:18px;animation:in .4s ease both}
@keyframes in{from{opacity:.001;transform:translateY(14px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.card,.pop,.food{animation:none!important;transition:none!important}.stages span i{transition:none}}
h1{font-size:clamp(24px,6vw,30px);line-height:1.3;margin:0;font-weight:800;text-wrap:balance}
h2{font-size:clamp(21px,5.4vw,25px);line-height:1.35;margin:0;font-weight:800;text-wrap:balance}
.hint{color:var(--muted);font-size:15px;margin:-8px 0 0}
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px}
.opts.big{grid-template-columns:1fr 1fr}
.opt{background:var(--panel2);border:1.5px solid var(--line);color:var(--text);border-radius:16px;padding:14px 12px;font:inherit;font-size:16px;font-weight:600;cursor:pointer;text-align:center;display:flex;flex-direction:column;align-items:center;gap:6px;transition:border-color .15s,transform .1s,background .15s}
.opt:hover{border-color:var(--accent)}
.opt:active{transform:scale(.97)}
.opt[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-soft)}
.opt .ic{font-size:30px;line-height:1}
.opt small{font-weight:400;color:var(--muted);font-size:13px}
.big .opt{padding:26px 12px}
.big .opt .ic{font-size:46px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{background:var(--panel2);border:1.5px solid var(--line);color:var(--text);border-radius:99px;padding:8px 16px;font:inherit;font-size:15px;cursor:pointer}
.chip[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-soft)}
input[type=text],input[type=tel],input[type=date],input[type=number],textarea{width:100%;background:var(--panel2);border:1.5px solid var(--line);border-radius:14px;color:var(--text);font:inherit;padding:14px 16px}
textarea{min-height:96px;resize:vertical}
input:focus,textarea:focus,button:focus-visible,label:focus-within{outline:2px solid var(--accent);outline-offset:2px}
.slider{display:flex;flex-direction:column;gap:10px;align-items:center}
.slider output{font-size:46px;font-weight:900;font-variant-numeric:tabular-nums;color:var(--accent);line-height:1}
.slider output small{font-size:18px;color:var(--muted);font-weight:500;margin-inline-start:6px}
input[type=range]{width:100%;accent-color:var(--accent);height:30px}
.stepper{display:flex;align-items:center;justify-content:center;gap:22px}
.stepper button{width:54px;height:54px;border-radius:50%;border:1.5px solid var(--line);background:var(--panel2);color:var(--text);font-size:28px;cursor:pointer}
.stepper output{font-size:46px;font-weight:900;color:var(--accent);min-width:70px;text-align:center;font-variant-numeric:tabular-nums}
.glasses{display:flex;flex-wrap:wrap;gap:4px;justify-content:center;font-size:22px;min-height:30px}
.scale{display:flex;justify-content:space-between;gap:6px}
.scale button{flex:1;background:var(--panel2);border:1.5px solid var(--line);border-radius:14px;padding:12px 0;font-size:30px;cursor:pointer}
.scale button[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-soft)}
.scale-lbl{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);margin-top:-8px}
.drop{border:2px dashed var(--line);border-radius:18px;padding:26px 16px;text-align:center;cursor:pointer;display:flex;flex-direction:column;gap:6px;align-items:center;transition:border-color .15s}
.drop:hover,.drop.over{border-color:var(--accent)}
.drop .ic{font-size:38px}
.files{display:flex;flex-direction:column;gap:6px;font-size:14px}
.files div{display:flex;justify-content:space-between;gap:10px;background:var(--panel2);border-radius:10px;padding:8px 12px}
.files div span:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nav{display:flex;gap:10px;align-items:center}
.btn{flex:1;background:var(--accent);color:#08101C;border:0;border-radius:16px;padding:15px;font:inherit;font-size:17px;font-weight:800;cursor:pointer}
.btn:disabled{opacity:.35;cursor:not-allowed}
.back{background:none;border:1.5px solid var(--line);color:var(--muted);border-radius:16px;padding:14px 18px;font:inherit;cursor:pointer}
.skip{background:none;border:0;color:var(--muted);font:inherit;font-size:14px;cursor:pointer;text-decoration:underline;align-self:center}
.feedback{background:var(--accent-soft);border-radius:14px;padding:12px 14px;font-size:15px;display:flex;gap:10px;align-items:flex-start}
.feedback.warn{background:rgba(242,179,91,.14)}
.pop{position:fixed;inset-inline:0;bottom:calc(24px + env(safe-area-inset-bottom,0px));margin:auto;width:max-content;max-width:calc(100% - 32px);background:var(--gold);color:#1B1403;font-weight:800;padding:10px 20px;border-radius:99px;animation:pop 1.6s ease both;pointer-events:none;z-index:5;text-align:center}
@keyframes pop{0%{opacity:0;transform:translateY(20px)}15%,75%{opacity:1;transform:none}100%{opacity:0;transform:translateY(-10px)}}
.stage-intro{text-align:center;align-items:center}
.stage-intro .ic{font-size:60px}
.badge{display:inline-block;font-size:13px;letter-spacing:.3px;color:var(--accent);background:var(--accent-soft);padding:3px 12px;border-radius:99px;font-weight:700}
.sum{display:flex;flex-direction:column;gap:2px;font-size:15px;margin:0}
.sum dt{color:var(--muted);font-size:13px;margin-top:8px}
.sum dd{margin:0}
.flag{color:var(--warn);font-weight:700}
.muted{color:var(--muted);font-size:14px}
.consent{display:flex;gap:10px;align-items:flex-start;font-size:15px;cursor:pointer}
.consent input{width:22px;height:22px;accent-color:var(--accent);flex:none;margin-top:3px}

/* day clock */
.day{display:grid;grid-template-columns:1fr;gap:16px;align-items:center}
.day svg{width:min(240px,100%);margin:auto;display:block}
.day .rows{display:flex;flex-direction:column;gap:10px}
.day label{display:grid;grid-template-columns:92px 1fr 64px;align-items:center;gap:10px;font-size:15px}
.day label output{font-variant-numeric:tabular-nums;text-align:left;font-weight:700}
.legend{display:flex;gap:14px;justify-content:center;font-size:13px;color:var(--muted);flex-wrap:wrap}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-inline-end:5px;vertical-align:middle}
.toggle{display:flex;gap:8px;align-items:center;font-size:15px;cursor:pointer}
.toggle input{width:20px;height:20px;accent-color:var(--accent)}

/* food deck */
.deck{position:relative;height:250px;display:grid;place-items:center;touch-action:pan-y}
.food{position:absolute;width:min(230px,80%);height:230px;background:var(--panel2);border:1.5px solid var(--line);border-radius:26px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;font-size:22px;font-weight:800;user-select:none;cursor:grab;transition:transform .3s ease,opacity .3s ease;box-shadow:0 20px 40px -20px rgba(0,0,0,.6)}
.food .em{font-size:84px;line-height:1}
.food.under{transform:scale(.92) translateY(14px);opacity:.5}
.food .tag{position:absolute;top:16px;font-size:15px;padding:3px 12px;border-radius:99px;opacity:0;transition:opacity .15s}
.food .tag.yes{inset-inline-start:16px;background:var(--mint);color:#08101C}
.food .tag.no{inset-inline-end:16px;background:var(--bad);color:#fff}
.votes{display:flex;justify-content:center;gap:14px}
.votes button{width:64px;height:64px;border-radius:50%;border:1.5px solid var(--line);background:var(--panel2);font-size:28px;cursor:pointer}
.votes button:active{transform:scale(.92)}
.deck-count{text-align:center;color:var(--muted);font-size:14px;font-variant-numeric:tabular-nums}

/* photos & measurements */
.shots{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.shot{aspect-ratio:3/4;max-width:100%;border:2px dashed var(--line);border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;cursor:pointer;overflow:hidden;position:relative;font-size:14px;color:var(--muted);background:var(--panel2)}
.shot .sil{font-size:40px;line-height:1;opacity:.6}
.shot img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.shot.ok{border-style:solid;border-color:var(--accent)}
.shot.ok b{position:absolute;bottom:6px;background:var(--accent);color:#08101C;border-radius:99px;padding:0 10px;font-size:13px}
.tips{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;font-size:14px;color:var(--muted);margin:0;padding:0;list-style:none}
.meas{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.meas label{display:flex;flex-direction:column;gap:4px;font-size:14px;color:var(--muted)}
.meas .in{position:relative}
.meas .in span{position:absolute;inset-inline-end:14px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--muted);pointer-events:none}
.meas input{padding-inline-end:44px;font-variant-numeric:tabular-nums}

/* reward card */
.reward{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;width:100%}
.reward div{background:var(--panel2);border-radius:14px;padding:12px 6px;display:flex;flex-direction:column;align-items:center;gap:2px}
.reward b{font-size:24px;color:var(--accent);font-variant-numeric:tabular-nums;line-height:1.2}
.reward span{font-size:12px;color:var(--muted);text-align:center}
.sending{display:flex;flex-direction:column;gap:8px;align-items:center;text-align:center}
.bar{width:100%;height:8px;border-radius:99px;background:var(--line);overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent);width:0;transition:width .3s}
.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
</style>
</head>
<body>
{% raw %}
<div class="wrap" dir="rtl" lang="ar">
  <header>
    <div class="logo">O2F<b>.</b> رحلتك</div>
    <div class="pts" id="pts">⭐ 0 نقطة</div>
  </header>
  <div class="stages" id="stages"></div>
  <div class="stage-name"><strong id="stageLabel">البداية</strong><span id="stageCount"></span></div>
  <main id="app"></main>
</div>

<script>
const A = {};            // answers
let g = null;            // 'm' | 'f'
let idx = 0, points = 0;
const previews = {};     // in-memory photo previews
const fileStore = {labs:[], photos:{}};  // File objects waiting for upload (not saved in the draft)
const t = (m, f) => (g === 'f' ? f : m);
const val = v => typeof v === 'function' ? v() : v;

const STAGES = [
  {id:'me',     name:'تعارف',       ic:'👋'},
  {id:'body',   name:'جسمك',        ic:'📏'},
  {id:'health', name:'صحتك',        ic:'🩺'},
  {id:'special',name:()=>t('صحة الرجل','صحة المرأة'), ic:()=>t('💪','🌸')},
  {id:'day',    name:'يومك',        ic:'🕐'},
  {id:'food',   name:'أكلك',        ic:'🥗'},
  {id:'goal',   name:'هدفك وتمرينك',ic:'🎯'},
  {id:'files',  name:'آخر خطوة', ic:'📩'},
];

const FOODS = [
  ['🍗','فراخ'],['🥩','لحمة حمرا'],['🐟','سمك'],['🦐','جمبري وبحريات'],['🥚','بيض'],['🧀','جبن'],
  ['🥛','لبن وزبادي'],['🥑','أفوكادو'],['🥦','خضار'],['🍠','بطاطا'],['🍚','رز'],['🍞','عيش'],
  ['🫘','بقوليات وفول'],['🥜','مكسرات'],['🍓','فواكه'],['🫒','زيت زيتون'],['☕','قهوة'],['🍫','شوكولاتة داكنة'],
];
const MEAS = [['chest','الصدر'],['arm','الزند'],['waist','الخصر'],['belly','البطن'],['hips','الأرداف'],['thigh','الفخذ'],['calf','بطة الساق']];

const STEPS = [
  {id:'welcome', stage:'me', type:'welcome'},
  {id:'gender', stage:'me', type:'choice', big:true, q:()=>'أول شي… أنت؟',
    opts:[{v:'m',ic:'🧔🏻',l:'رجل'},{v:'f',ic:'🧕🏻',l:'امرأة'}]},
  {id:'name', stage:'me', type:'text', q:()=>t('ايش اسمك؟ عشان أناديك فيه','ايش اسمك؟ عشان أناديكي فيه'), ph:'الاسم الأول يكفي'},
  {id:'age', stage:'me', type:'slider', q:()=>`هلا ${A.name||''}! كم عمرك؟`, min:12,max:85,def:35,unit:'سنة',
    fb:v=> v<16 ? {warn:1,m:'تحت 16 سنة لازم أتكلم مع ولي الأمر قبل أي برنامج، وأنا أتواصل معكم.'} : null},
  {id:'country', stage:'me', type:'choice', q:()=>t('وين ساكن؟','وين ساكنة؟'),
    opts:[{v:'egypt',ic:'🇪🇬',l:'مصر'},{v:'gulf',ic:'🌴',l:'الخليج'},{v:'intl',ic:'🌍',l:'دولة ثانية'}]},
  {id:'city', stage:'me', type:'text', optional:true, q:()=>'المدينة؟', ph:'مثلاً: الخبر، القاهرة، دبي'},
  {id:'whatsapp', stage:'me', type:'text', inputType:'tel', q:()=>'رقم الواتساب؟', hint:'عليه برسلك البرنامج وأتابع معك', ph:'+20 1xx xxx xxxx'},
  {id:'plan', stage:'me', type:'choice', q:()=>t('كم مدة اشتراكك في باقة التحول الشامل؟','كم مدة اشتراكك في باقة التحول الشامل؟'),
    opts:()=>[{v:'m1',ic:'1️⃣',l:'شهر'},{v:'m3',ic:'⭐',l:'3 شهور'},{v:'m6',ic:'🔥',l:'6 شهور'},{v:'help',ic:'🤔',l:'للحين ما قررت، ساعدني أختار'}]},

  {id:'body_i', stage:'body', type:'intro', q:()=>'خلّينا نتعرف على جسمك', hint:'أرقام بسيطة، بالسحب مو بالكتابة'},
  {id:'height', stage:'body', type:'slider', q:()=>'كم طولك؟', min:130,max:210,def:()=>t(175,162),unit:'سم'},
  {id:'weight', stage:'body', type:'slider', q:()=>'ووزنك الحين؟', hint:()=>t('الأدق: الصبح على الريق بعد الحمّام','الأدق: الصبح على الريق بعد الحمّام'), min:35,max:200,def:()=>t(85,70),unit:'كجم',
    fb:v=>{const b=v/((A.height/100)**2); const r=b<18.5?'أقل من الطبيعي':b<25?'في المعدل الطبيعي':b<30?'زيادة وزن':'سمنة'; return {m:`مؤشر كتلة الجسم عندك <b>${b.toFixed(1)}</b> (${r}). هذا رقم مبدئي بس، الأهم عندي تركيب الجسم، وهذا اللي نشتغل عليه سوا.`}}},
  {id:'tools', stage:'body', type:'multi', q:()=>'ايش عندك من هذي الأدوات في البيت؟', hint:'عشان أعرف كيف نقيس تقدّمك', none:'ولا شي',
    opts:['⚖️ ميزان جسم','🍽️ ميزان أكل','📏 شريط قياس','🏋️ دمبلز','🧘 مات يوجا','🎗️ أستك مقاومة']},

  {id:'health_i', stage:'health', type:'intro', q:()=>'الحين شوية أسئلة عن صحتك', hint:'كل هذا سري، وما يشوفه أحد غيري'},
  {id:'conditions', stage:'health', type:'multi', q:()=>'عندك شي من هذي؟', hint:'اختار كل اللي ينطبق', none:'ولا شي الحمد لله',
    opts:['سكر','مقاومة إنسولين','ضغط','غدة درقية','كوليسترول / دهون','دهون على الكبد','قولون / معدة','جرثومة المعدة','أنيميا','نقص G6PD','حساسية','مشاكل مفاصل / ضهر','صداع نصفي','أخرى']},
  {id:'meds', stage:'health', type:'textarea', optional:true, q:()=>t('تاخذ أدوية أو عقاقير الحين؟','تاخذي أدوية أو عقاقير الحين؟'), hint:()=>t('اكتب الاسم والجرعة لو تتذكرها','اكتبي الاسم والجرعة لو تتذكريها'), ph:'مثلاً: جلوكوفاج 500 مرتين في اليوم'},
  {id:'surgery', stage:'health', type:'textarea', optional:true, q:()=>t('سويت عمليات أو عندك إصابات قبل؟','سويتي عمليات أو عندك إصابات قبل؟'), ph:'مثلاً: رباط صليبي 2019'},
  {id:'energy', stage:'health', type:'scale', q:()=>'كيف طاقتك خلال اليوم؟', lo:'مطفي تماماً', hi:'فل الفل'},
  {id:'stress', stage:'health', type:'scale', emo:['😌','🙂','😐','😟','🤯'], q:()=>'ومستوى التوتر والضغط؟', lo:'هادي', hi:'مضغوط جداً'},
  {id:'sleepq', stage:'health', type:'scale', emo:['😵','🥱','😐','🙂','😴'], q:()=>'وجودة نومك؟', lo:'متقطع ومو مريح', hi:'عميق ومريح'},
  {id:'digestion', stage:'health', type:'multi', q:()=>'والهضم؟', none:'الهضم تمام', opts:['انتفاخ','إمساك','إسهال','حموضة','غازات','ثقل بعد الأكل']},

  {id:'special_i', stage:'special', type:'intro', q:()=>t('أسئلة خاصة بصحة الرجل','أسئلة خاصة فيكي كأنثى'), hint:()=>t('تفرق معاي كثير في اختيار المكمّلات والتمرين','الهرمونات تفرق معاي كثير في الأكل والتمرين والمكمّلات')},
  {id:'cycle', stage:'special', show:()=>g==='f', type:'choice', q:()=>'الدورة الشهرية منتظمة؟',
    opts:[{v:'regular',ic:'🗓️',l:'منتظمة'},{v:'irregular',ic:'🔀',l:'مو منتظمة'},{v:'stopped',ic:'⏸️',l:'انقطعت / سن اليأس'},{v:'preg',ic:'🤰',l:'حامل'},{v:'bf',ic:'🍼',l:'مرضعة'}],
    fb:v=> (v==='preg'||v==='bf') ? {warn:1,m:'مبروك! في هذي الحالة أسوي البرنامج بحرص خاص وبالتنسيق مع دكتورتك، وأنا أتواصل معك بنفسي.'} : null},
  {id:'last_period', stage:'special', show:()=>g==='f' && ['regular','irregular'].includes(A.cycle), type:'date', optional:true, q:()=>'متى كان أول يوم في آخر دورة؟', hint:'يساعدني أظبط التمرين والأكل على مراحل الدورة'},
  {id:'women_issues', stage:'special', show:()=>g==='f', type:'multi', q:()=>'عندك أي مشاكل نسائية من هذي؟', none:'لا الحمد لله',
