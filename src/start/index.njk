  {id:'allergy', stage:'food', type:'textarea', optional:true, q:()=>'عندك حساسية من أي أكل؟', ph:'مثلاً: لاكتوز، جلوتين، فول سوداني'},
  {id:'budget', stage:'food', type:'choice', q:()=>'الميزانية المناسبة للأكل والمكمّلات؟', hint:()=>t('عشان أختار لك أشياء تقدر تكمّل عليها','عشان أختار لك أشياء تقدري تكمّلي عليها'),
    opts:[{v:'eco',ic:'🪙',l:'اقتصادية'},{v:'mid',ic:'💵',l:'متوسطة'},{v:'open',ic:'💎',l:'مفتوحة'}]},
  {id:'supps', stage:'food', type:'textarea', optional:true, q:()=>t('تاخذ مكمّلات الحين؟','تاخذي مكمّلات الحين؟'), ph:'مثلاً: فيتامين د 5000، أوميجا 3، ماغنسيوم'},
  {id:'peptides', stage:'food', type:'choice', q:()=>t('تستخدم ببتيدات أو حقن حالياً؟','تستخدمي ببتيدات أو حقن حالياً؟'),
    opts:[{v:'no',ic:'✖️',l:'لا'},{v:'yes',ic:'💉',l:'ايه'}]},
  {id:'peptides_detail', stage:'food', show:()=>A.peptides==='yes', type:'textarea', q:()=>t('اكتب اسمها والجرعة والمواعيد','اكتبي اسمها والجرعة والمواعيد'), ph:'مثلاً: BPC-157 250mcg يومياً'},

  {id:'goal_i', stage:'goal', type:'intro', q:()=>'هدفك وتمرينك', hint:'هنا نرسم سوا شكل النتيجة'},
