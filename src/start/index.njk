  {id:'measures', stage:'files', type:'measure', optional:true, q:()=>'مقاساتك بالسنتيمتر'},
  {id:'has_labs', stage:'files', type:'choice', q:()=>'عندك تحاليل حديثة (آخر 3 شهور)؟', hint:()=>t('ترسلها لي في الواتساب بعد ما تخلص','ترسليها لي في الواتساب بعد ما تخلصي'),
    opts:[{v:'yes',ic:'📄',l:'ايه، عندي'},{v:'old',ic:'🗂️',l:'عندي بس قديمة'},{v:'no',ic:'✖️',l:'لا، ما عندي'}]},
  {id:'pay', stage:'files', type:'choice', q:()=>'ايش طريقة الدفع المناسبة لك؟',
    opts:[{v:'bank',ic:'🏦',l:'تحويل بنكي'},{v:'wallet',ic:'📱',l:'محفظة إلكترونية'},{v:'instapay',ic:'⚡',l:'إنستاباي'}]},
  {id:'extra', stage:'files', type:'textarea', optional:true, q:()=>t('في أي معلومة أو تنبيه تبغى تقوله لي؟','في أي معلومة أو تنبيه تبغي تقوليه لي؟'), ph:'أي شي في بالك…'},
